{
  "name": "learnlytics-v2-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static LearnLytics website with a Supabase-powered Learning Hub.",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "start": "node scripts/preview.mjs",
    "theme:blue": "node scripts/set-theme.mjs blue",
    "theme:plum": "node scripts/set-theme.mjs plum",
    "test:theme": "node tests/theme.cjs",
    "test:testimonials": "node tests/testimonials.cjs",
    "test": "node tests/homepage.cjs && node tests/product.cjs && node tests/analyst.cjs && node tests/engineer.cjs && node tests/complete.cjs && node tests/navigation.cjs && node tests/theme.cjs && node tests/testimonials.cjs && node tests/form-handler.cjs && node tests/career-resources.cjs",
    "test:resources": "node tests/form-handler.cjs && node tests/career-resources.cjs",
    "test:complete": "node tests/complete.cjs",
    "test:engineer": "node tests/engineer.cjs",
    "test:analyst": "node tests/analyst.cjs",
    "test:product": "node tests/product.cjs",
    "build:llh": "node scripts/build-llh.mjs",
    "build:public": "node scripts/build-public.mjs",
    "test:llh": "node --test tests/llh-*.test.mjs",
    "test:llh:browser": "node tests/llh-browser.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.28.2"
  }
}
