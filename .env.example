# Template ONLY. Set actual secrets in Vercel > Project > Settings > Environment Variables.
# Start in inspection mode; this never sends a Purchase.
CAPI_MODE=inspect
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

META_PIXEL_ID=1441817607724869
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_TEST_EVENT_CODE=
SITE_URL=https://learnlyticshandbook.shop

# Set only after inspecting the real test payload and, if necessary, fetched entities.
# JSON pointer rooted at {webhook,payment,order,customer}. No default/guessed field.
RAZORPAY_PRODUCT_ID_PATH=
# Optional additional test button IDs or merchant-owned product references mapped to:
# data_analyst | ml_engineer | ds_genai | combined_bundle
RAZORPAY_PRODUCT_MAP_JSON={}
# Optional: order,customer (enable only the resources the inspected payload needs).
RAZORPAY_ENRICH_RESOURCES=

# One durable atomic store, connected through Vercel Marketplace (Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Leave disabled. Only after the actual test and duplicate re-delivery are confirmed in Meta.
CAPI_LIVE_APPROVED=false
CAPI_VERIFIED_TEST_PAYMENT_ID=
